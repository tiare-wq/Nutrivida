{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "NutriVida: iniciar todo (con datos iniciales)",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ${workspaceFolder}\\Iniciar.ps1 -DatosIniciales -Abrir",
      "presentation": { "panel": "dedicated", "focus": true },
      "problemMatcher": []
    },
    {
      "label": "NutriVida: iniciar solo con el administrador",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ${workspaceFolder}\\Iniciar.ps1 -Abrir",
      "presentation": { "panel": "dedicated", "focus": true },
      "problemMatcher": []
    },
    {
      "label": "NutriVida: detener",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ${workspaceFolder}\\Detener.ps1",
      "problemMatcher": []
    },
    {
      "label": "Backend: compilar y probar (mvn clean verify)",
      "type": "shell",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/Verificar-Backend.ps1"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Frontend: instalar dependencias",
      "type": "shell",
      "command": "npm ci",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    },
    {
      "label": "Frontend: pruebas",
      "type": "shell",
      "command": "npm test",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
