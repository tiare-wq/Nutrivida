# Copiar como .env y reemplazar todos los valores antes de ejecutar Docker.
JWT_SECRET=REEMPLAZAR_CON_SECRETO_ALEATORIO_DE_48_CARACTERES_O_MAS
DB_PASSWORD=REEMPLAZAR_PASSWORD_POSTGRES
ADMIN_EMAIL=admin@nutrivida.cl
ADMIN_PASSWORD=REEMPLAZAR_PASSWORD_ADMIN_CON_LETRAS_Y_NUMEROS
# Opcional: clave distinta para cada cuenta de prueba; si se omite, usa ADMIN_PASSWORD.
# CLAVE_INICIAL_VALENTINA=
# CLAVE_INICIAL_MATIAS=
# CLAVE_INICIAL_ESTEBAN=
# CLAVE_INICIAL_JUAN=
# CLAVE_INICIAL_CAMILO=
# true al publicar con HTTPS; false solo para trabajo local con HTTP.
COOKIE_SECURE=false
# true crea una vez dos nutricionistas y tres pacientes con medidas.
CARGAR_DATOS_INICIALES=false
